# Local development only; demo/staging/production builds must provide an
# explicit origin at build time.
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_MNEME_ENV=development

# Mock 模式(true = 不打后端,用本地 mock 数据)
NEXT_PUBLIC_USE_MOCK=true

# The retired NEXT_PUBLIC_MNEME_API_BASE variable is rejected.
