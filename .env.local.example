# Mneme API base URL (build-time; set a distinct value per artifact)
# 生产: https://sxueji.com
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_MNEME_ENV=development

# Mock 模式(true = 不打后端,用本地 mock 数据)
NEXT_PUBLIC_USE_MOCK=true

# Demo/staging builds must provide their own NEXT_PUBLIC_API_BASE; the legacy
# NEXT_PUBLIC_MNEME_API_BASE variable is rejected.
