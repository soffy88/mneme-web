# Mneme production release artifact API (build-time)
# 同源: Caddy 在 sxueji.com 上把 /v1/* /v2/* /mcp/* /health 反代到 API。
# 不要用 api-prod/api-staging/api-demo.sxueji.com —— 这三个域名当前没有 DNS
# 记录, 前端会全线 DNS 解析失败(表现为"无法连接到服务器"/"无法发送验证码")。
NEXT_PUBLIC_MNEME_ENV=production
NEXT_PUBLIC_API_BASE=https://sxueji.com
NEXT_PUBLIC_USE_MOCK=false
